<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <title>Ayo Belajar</title>
  <style>
    body {
      margin: 0;
      padding: 0;
      background-color: #000;
      color: #fff;
      font-family: Arial, sans-serif;
      text-align: center;
      overflow: hidden;
    }

    h1 {
      margin-top: 50px;
      font-size: 40px;
    }

    .stiker {
      font-size: 50px;
      margin: 10px;
    }

    .container {
      margin-top: 50px;
      position: relative;
      height: 300px;
    }

    button {
      padding: 15px 30px;
      font-size: 18px;
      border: none;
      border-radius: 10px;
      cursor: pointer;
      margin: 10px;
      transition: 0.2s;
    }

    #mau {
      background-color: #00ff88;
      color: black;
    }

    #tidak {
      background-color: #ff4444;
      color: white;
      position: absolute;
    }

    #pesan {
      margin-top: 30px;
      font-size: 22px;
      color: #00ff88;
    }
  </style>
</head>
<body>

  <h1>📚 Ayo Belajar!</h1>
  <div class="stiker">✨📖✏️💡</div>

  <div class="container">
    <button id="mau">Mau</button>
    <button id="tidak">Tidak</button>
  </div>

  <div id="pesan"></div>

  <script>
    const tombolTidak = document.getElementById("tidak");
    const tombolMau = document.getElementById("mau");
    const pesan = document.getElementById("pesan");

    // Fungsi untuk memindahkan tombol "Tidak"
    tombolTidak.addEventListener("mouseover", () => {
      const x = Math.random() * (window.innerWidth - 100);
      const y = Math.random() * (window.innerHeight - 100);

      tombolTidak.style.left = x + "px";
      tombolTidak.style.top = y + "px";
    });

    // Saat klik "Mau"
    tombolMau.addEventListener("click", () => {
      pesan.innerHTML = "🎉 Mantap! Belajar itu kunci sukses! Kamu pasti bisa! 💪📚✨";
    });
  </script>

</body>
</html>
